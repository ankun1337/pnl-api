# pnl-api 配置模板。cp .env.example .env 后填写；.env 永不入库。

# J-Quants V2 API key（从控制台发行）。永不出现在日志、代码、提交、报告。
JQUANTS_API_KEY=

# 硬性要求 127.0.0.1，其他值拒绝启动
API_BIND=127.0.0.1
API_PORT=8642

# 本地鉴权 key。生成：python3 -c "import secrets; print(secrets.token_hex(32))"
API_KEY_LOCAL=

# 取价回看的自然日窗口（约 30 个交易日）
LOOKBACK_DAYS=45

# 单次 J-Quants 请求超时（秒）
TIMEOUT_S=10
